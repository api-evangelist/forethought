          "name": "Continue A Solve Conversation",
          "request": {
            "name": "Continue A Solve Conversation",
            "description": {
              "content": "Continue an existing Solve conversation by sending an additional query\nand/or updated context variables. The Solve agent returns the next\nassistant response, surface workflow state, and any escalation\ninstructions.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "solve",
                "api",
                "v1",
                "conversation",
                ":conversation_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "conversation_id",
                  "description": "(Required) The conversation_id returned by the initial start call."
                }
              ]
            },
