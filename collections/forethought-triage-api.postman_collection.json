  "info": {
    "_postman_id": "77a48ae5-4082-4d3f-8079-a544be3baebe",
    "name": "Forethought Triage API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Forethought Triage API classifies customer-support tickets and predicts\nthe most likely category, sub-category, language, sentiment, or other label\nyour Triage model is trained on. Forethought's Implementation Engineering\nteam trains and deploys the model and issues a bearer token. Submit the\nticket subject (`text_a`) and body (`text_b`) and the API returns ranked\npredictions with confidence scores.\n\n\nContact Support:\n Name: Forethought Support",
      "type": "text/plain"
    }
  }
